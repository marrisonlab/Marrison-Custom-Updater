msgid "Per trasformare una cartella del tuo server in un Repository Privato compatibile con WP Master Updater, segui questi passaggi:"
msgstr "To turn a folder on your server into a Private Repository compatible with WP Master Updater, follow these steps:"

msgid "1. Repository Plugin"
msgstr "1. Plugin Repository"

msgid "Crea una cartella pubblica sul tuo server (es. <code>https://tuosito.com/my-repo/plugins/</code>)."
msgstr "Create a public folder on your server (e.g. <code>https://your-site.com/my-repo/plugins/</code>)."

msgid "Scarica il file <code>index.php</code> qui sotto."
msgstr "Download the <code>index.php</code> file below."

msgid "Carica il file nella cartella appena creata."
msgstr "Upload the file to the folder you just created."

msgid "Carica i file <code>.zip</code> dei tuoi plugin nella stessa cartella."
msgstr "Upload your plugin <code>.zip</code> files to the same folder."

msgid "Inserisci l'URL della cartella (es. <code>https://tuosito.com/my-repo/plugins/</code>) nelle Impostazioni di questo plugin."
msgstr "Enter the folder URL (e.g. <code>https://your-site.com/my-repo/plugins/</code>) in this plugin's Settings."

msgid "Scarica index.php per Plugin"
msgstr "Download index.php for Plugins"

msgid "2. Repository Temi"
msgstr "2. Theme Repository"

msgid "Crea una cartella pubblica sul tuo server (es. <code>https://tuosito.com/my-repo/themes/</code>)."
msgstr "Create a public folder on your server (e.g. <code>https://your-site.com/my-repo/themes/</code>)."

msgid "Scarica il file <code>index.php</code> qui sotto (specifico per i temi)."
msgstr "Download the <code>index.php</code> file below (theme-specific)."

msgid "Carica i file <code>.zip</code> dei tuoi temi nella stessa cartella."
msgstr "Upload your theme <code>.zip</code> files to the same folder."

msgid "Inserisci l'URL della cartella (es. <code>https://tuosito.com/my-repo/themes/</code>) nelle Impostazioni di questo plugin."
msgstr "Enter the folder URL (e.g. <code>https://your-site.com/my-repo/themes/</code>) in this plugin's Settings."

msgid "Scarica index.php per Temi"
msgstr "Download index.php for Themes"

